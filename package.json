{
  "name": "paper-couture",
  "private": true,
  "version": "0.1.0",
  "description": "A quiet Three.js workshop for folding one patterned square into a paper dress.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "node --import tsx scripts/check.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "npm run check"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/three": "0.170.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vite": "6.0.7"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  }
}
